# ShieldWealth environment variables
#   cp env.example .env   (never commit .env; it is gitignored)
#
# Without a key the app runs every agent offline with a deterministic model.

# Google Gemini API key, needed only for "Gemini" mode. https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: override the Gemini model used by all nine agents.
# SHIELDWEALTH_MODEL=gemini-2.5-flash

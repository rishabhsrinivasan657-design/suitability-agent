# ─────────────────────────────────────────────────────────────────────────────
# ShieldWealth AI — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:   cp env.example .env
#   2. Fill in your real API keys below
#   3. Run Docker:       docker run -p 8501:8501 --env-file .env shieldwealth
#
# ⚠️  NEVER commit your real .env file to Git. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Gemini API key (required for the AI compliance agents) ─────────────
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ── OpenAI API key (optional — only needed if using OpenAI models) ────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Google Vertex AI toggle (set to False unless you have a GCP project) ──────
GOOGLE_GENAI_USE_VERTEXAI=False
